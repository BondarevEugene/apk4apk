[app]

# Назва застосунку
title = My Book App

# Назва пакету
package.name = bookapp
package.domain = org.yevhenii

# Шлях до основного файлу
source.dir = .
source.include_exts = py,png,jpg,json,kv

# Головний файл
main = main.py

# Версія
version = 0.1

# Вимоги
requirements = python3,kivy,kivymd

# Орієнтація
orientation = portrait

# Повноекранний режим
fullscreen = 0


[buildozer]

# Рівень логування
log_level = 2

# Не очищати збірку автоматично
warn_on_root = 1

